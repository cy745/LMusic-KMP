language = Objective-C
package = com.lalilu.lmedia
---
#import <Foundation/Foundation.h>

@class ArtworkItem;
@class SongInfo;
@class MusicKitPlayerController;

/// Completion handler for fetchUserLibrarySongs
/// @param songs Array of SongInfo objects, or nil if failed
/// @param error Error object if failed, nil otherwise
typedef void (^MusicKitWrapperFetchCompletion)(NSArray<SongInfo *> * _Nullable songs, NSError * _Nullable error);

#pragma mark - ArtworkItem

@interface ArtworkItem : NSObject

/// Maximum available width for this artwork (0 = unknown)
@property (nonatomic, readonly) NSInteger maxWidth;
/// Maximum available height for this artwork (0 = unknown)
@property (nonatomic, readonly) NSInteger maxHeight;

/// Get artwork URL with specified dimensions
/// @param width The width dimension
/// @param height The height dimension
/// @return The artwork URL or nil if unavailable
- (nullable NSURL *)urlWithWidth:(NSInteger)width height:(NSInteger)height;

@end

#pragma mark - SongInfo

@interface SongInfo : NSObject

/// Song title
- (NSString *)title;
/// Artist name
- (NSString *)artist;
/// Album name
- (NSString *)album;
/// Song duration in seconds
- (NSTimeInterval)duration;
/// Artwork item for album art
- (nullable ArtworkItem *)artwork;
/// Song URL
- (nullable NSURL *)url;
/// Store ID (MusicItemID as string), used for playback
- (NSString *)storeID;

/// Initialize SongInfo with all properties
/// @param title Song title
/// @param artist Artist name
/// @param album Album name
/// @param duration Song duration in seconds
/// @param artwork ArtworkItem for album art
/// @param url Song URL
/// @param storeID Store ID string
/// @return Initialized SongInfo instance
- (instancetype)initWithTitle:(NSString *)title
                      artist:(NSString *)artist
                       album:(NSString *)album
                    duration:(NSTimeInterval)duration
                    artwork:(nullable ArtworkItem *)artwork
                         url:(nullable NSURL *)url
                     storeID:(NSString *)storeID;

@end

#pragma mark - MusicKitPlayerControllerDelegate

@protocol MusicKitPlayerControllerDelegate <NSObject>
@required
- (void)onPlaybackStateChangedWithIsPlaying:(BOOL)isPlaying
                              playbackTime:(double)playbackTime
                                  duration:(double)duration;
- (void)onDidFinishPlaying;
- (void)onPlaybackErrorWithError:(NSError *)error;
@end

#pragma mark - MusicKitPlayerController

@interface MusicKitPlayerController : NSObject

/// Delegate for receiving playback state updates
@property (nonatomic, weak, nullable) id<MusicKitPlayerControllerDelegate> delegate;

/// Number of songs currently in cache
@property (nonatomic, readonly) NSInteger cachedSongCount;

/// Synchronous playback state queries
@property (nonatomic, readonly) double currentPlaybackTime;
@property (nonatomic, readonly) double currentDuration;
@property (nonatomic, readonly) BOOL isCurrentlyPlaying;

/// Populate the song cache from SongInfo objects.
- (void)configureWithSongInfos:(NSArray<SongInfo *> *)songInfos;

/// Set queue to a single song by its store ID (must be in cache).
/// Does NOT start playback — call [resumePlayback] separately.
- (void)setQueueWithStoreID:(NSString *)storeID;

/// Start or resume playback of the currently queued song.
- (void)resumePlayback;

/// Pause current playback.
- (void)pausePlayback;

/// Stop current playback and clear state.
- (void)stopPlayback;

/// Skip to next entry in the player's internal queue.
- (void)skipToNext;

/// Skip to previous entry.
- (void)skipToPrevious;

/// Seek to a specific time in seconds.
- (void)seekTo:(double)time;

/// Release resources — call when switching to another playback engine.
- (void)invalidate;

/// Fetch artwork image data for a song at the given dimensions (returns JPEG/PNG bytes, or nil).
- (nullable NSData *)artworkDataForStoreID:(NSString *)storeID width:(NSInteger)width height:(NSInteger)height;

/// Retrieve lyrics for a song by its store ID (via MPMediaItem lookup, may return nil).
- (nullable NSString *)lyricsForStoreID:(NSString *)storeID;

/// Shared singleton controller
+ (instancetype)shared;

@end

#pragma mark - MusicKitWrapper

@interface MusicKitWrapper : NSObject

/// Returns a greeting message
/// @return "HeLLo WorLd! MusicKitWrapper"
+ (NSString *)helloWorld;

/// Fetches user library songs from MusicKit
/// This method requests music authorization and fetches the user's library songs
/// @param completion Completion handler called with songs or error
///                   On success: songs array (may be empty), error is nil
///                   On failure: songs is nil, error contains failure reason
+ (void)fetchUserLibrarySongsWithCompletionHandler:(MusicKitWrapperFetchCompletion)completion;

@end
